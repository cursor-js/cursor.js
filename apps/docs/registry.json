{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "cursorjs-ui",
  "homepage": "https://cursorjs.com/ui",
  "items": [
    {
      "name": "cursor-player",
      "type": "registry:block",
      "title": "Cursor Player",
      "description": "A free compound component for starting, pausing, resuming, and stopping cursor.js demos.",
      "dependencies": ["@cursor.js/core", "lucide-react"],
      "registryDependencies": ["button", "card"],
      "files": [
        {
          "path": "registry/default/cursor-player/cursor-player.tsx",
          "type": "registry:component",
          "target": "@components/cursor-player.tsx"
        },
        {
          "path": "registry/default/cursor-player/use-cursor-player.ts",
          "type": "registry:hook",
          "target": "@hooks/use-cursor-player.ts"
        }
      ]
    }
  ]
}
